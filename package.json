{
  "name": "experiment-inventory",
  "private": true,
  "description": "A canvas gathering game with a weight- and volume-limited inventory.",
  "type": "module",
  "scripts": {
    "build": "bun build src/game.ts --outdir dist --target browser --sourcemap=external",
    "check": "tsc --noEmit",
    "dev": "bun build src/game.ts --outdir dist --target browser --sourcemap=external --watch",
    "fmt": "oxfmt --config oxfmt.config.ts",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check",
    "start": "bun serve.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.68.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
